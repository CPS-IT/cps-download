parameters:
	ignoreErrors:
		# Reason: class is deleted with the core plugin registration (C8), entries go with it
		-
			message: '#^Property Cpsit\\CpsDownload\\Configuration\\Plugin\\DownloadListPluginConfiguration\:\:\$controllerActions type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: Classes/Configuration/Plugin/DownloadListPluginConfiguration.php

		-
			message: '#^Property Cpsit\\CpsDownload\\Configuration\\Plugin\\DownloadListPluginConfiguration\:\:\$nonCacheableControllerActions type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: Classes/Configuration/Plugin/DownloadListPluginConfiguration.php

		# Reason: class is deleted with the core plugin registration (C8), entries go with it
		-
			message: '#^Property Cpsit\\CpsDownload\\Configuration\\Plugin\\DownloadListSelectedPluginConfiguration\:\:\$controllerActions type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: Classes/Configuration/Plugin/DownloadListSelectedPluginConfiguration.php

		-
			message: '#^Property Cpsit\\CpsDownload\\Configuration\\Plugin\\DownloadListSelectedPluginConfiguration\:\:\$nonCacheableControllerActions type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: Classes/Configuration/Plugin/DownloadListSelectedPluginConfiguration.php

		# Reason: controller rework (C6): nullable constructor and doc type; authorIds string list is an existing input contract
		-
			message: '#^PHPDoc tag @var for property Cpsit\\CpsDownload\\Controller\\DownloadController\:\:\$downloadRepository with type Cpsit\\CpsDownload\\Domain\\Repository\\DownloadRepository\|null is not subtype of native type Cpsit\\CpsDownload\\Domain\\Repository\\DownloadRepository\.$#'
			identifier: property.phpDocType
			count: 1
			path: Classes/Controller/DownloadController.php

		-
			message: '#^Parameter \#1 \$authorIds of method Cpsit\\CpsDownload\\Domain\\Model\\Dto\\DownloadDemand\:\:setAuthorIds\(\) expects array\<int\>, list\<string\> given\.$#'
			identifier: argument.type
			count: 1
			path: Classes/Controller/DownloadController.php

		# Reason: defensive proxy check kept for lazy loaded parent
		-
			message: '#^Instanceof between Cpsit\\CpsDownload\\Domain\\Model\\Category\|null and TYPO3\\CMS\\Extbase\\Persistence\\Generic\\LazyLoadingProxy will always evaluate to false\.$#'
			identifier: instanceof.alwaysFalse
			count: 1
			path: Classes/Domain/Model/Category.php

		# Reason: dead method calling a missing getCategories(), decided in the unused-code commit (C11)
		-
			message: '#^Call to an undefined method Cpsit\\CpsDownload\\Domain\\Model\\Dto\\DownloadDemand\:\:getCategories\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: Classes/Domain/Model/Dto/DownloadDemand.php

		# Reason: query builder code is reworked in C4 (ConnectionPool injection)
		-
			message: '#^Parameter \#2 \$y of method Doctrine\\DBAL\\Query\\Expression\\ExpressionBuilder\:\:in\(\) expects array\<string\>\|string, array\<int\> given\.$#'
			identifier: argument.type
			count: 1
			path: Classes/Domain/Repository/DownloadRepository.php

		# Reason: class is reworked or removed in C5
		-
			message: '#^Method Cpsit\\CpsDownload\\Service\\PageService\:\:expandPagesWithSubPages\(\) has parameter \$pages with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: Classes/Service/PageService.php

		-
			message: '#^Method Cpsit\\CpsDownload\\Service\\PageService\:\:getTreeList\(\) has no return type specified\.$#'
			identifier: missingType.return
			count: 1
			path: Classes/Service/PageService.php

		-
			message: '#^Method Cpsit\\CpsDownload\\Service\\PageService\:\:getTreeList\(\) has parameter \$begin with no type specified\.$#'
			identifier: missingType.parameter
			count: 1
			path: Classes/Service/PageService.php

		-
			message: '#^Method Cpsit\\CpsDownload\\Service\\PageService\:\:getTreeList\(\) has parameter \$depth with no type specified\.$#'
			identifier: missingType.parameter
			count: 1
			path: Classes/Service/PageService.php

		-
			message: '#^Method Cpsit\\CpsDownload\\Service\\PageService\:\:getTreeList\(\) has parameter \$id with no type specified\.$#'
			identifier: missingType.parameter
			count: 1
			path: Classes/Service/PageService.php

		-
			message: '#^Method Cpsit\\CpsDownload\\Service\\PageService\:\:getTreeList\(\) has parameter \$permClause with no type specified\.$#'
			identifier: missingType.parameter
			count: 1
			path: Classes/Service/PageService.php

		-
			message: '#^Parameter \#2 \$type of method TYPO3\\CMS\\Core\\Database\\Query\\QueryBuilder\:\:createNamedParameter\(\) expects Doctrine\\DBAL\\ArrayParameterType\|Doctrine\\DBAL\\ParameterType\|Doctrine\\DBAL\\Types\\Type\|string, int given\.$#'
			identifier: argument.type
			count: 1
			path: Classes/Service/PageService.php
